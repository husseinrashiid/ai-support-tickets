generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Ticket {
  id                     String   @id @default(cuid())
  title                  String
  message                String
  category               String?
  priority               String?
  status                 String   @default("Open")
  aiSummary              String?
  aiSuggestedResponse    String?
  ownerId                String?
  owner                  User?    @relation(fields: [ownerId], references: [id])
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([ownerId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String
  createdAt    DateTime @default(now())
  tickets      Ticket[]
}